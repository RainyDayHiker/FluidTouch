{
  "name": "gcode-core",
  "version": "0.4.0-build.100",
  "description": "C++17 port of the G-code Editor core: reading, Rotate, Flip and Outline Check, identical to the TypeScript reference",
  "keywords": ["gcode", "cnc", "fluidnc"],
  "license": "MIT",
  "frameworks": "*",
  "platforms": "*",
  "build": {
    "srcDir": "src",
    "includeDir": "include",
    "flags": ["-fno-exceptions", "-fno-rtti", "-ffp-contract=off", "-std=gnu++17"],
    "unflags": ["-std=gnu++11", "-std=gnu++14"]
  }
}
